{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/attributes.schema.json",
  "title": "release/<build>/attributes.json.gz (decompressed): the attributes the server sends a joining player",
  "type": "object",
  "required": ["attributes"],
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "description": "update_attributes for the player, in the server's order",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "min", "max", "default", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "description": "minecraft:movement, minecraft:player.hunger", "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "default": { "type": "number" },
          "value": { "description": "What the player has when it joins", "type": "number" }
        }
      }
    }
  }
}
