{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/steve.schema.json",
  "title": "release/<build>/steve.json.gz (decompressed): the default skin a client of the release's version sends in its login",
  "type": "object",
  "required": [
    "AnimatedImageData",
    "ArmSize",
    "CapeData",
    "CapeId",
    "CapeImageHeight",
    "CapeImageWidth",
    "CapeOnClassicSkin",
    "PersonaPieces",
    "PersonaSkin",
    "PieceTintColors",
    "PremiumSkin",
    "SkinAnimationData",
    "SkinColor",
    "SkinData",
    "SkinGeometryData",
    "SkinId",
    "SkinImageHeight",
    "SkinImageWidth",
    "SkinResourcePatch"
  ],
  "additionalProperties": false,
  "properties": {
    "AnimatedImageData": { "description": "Its animations (the blinking face), each image base64", "type": "array", "items": { "type": "object" } },
    "ArmSize": { "type": "string" },
    "CapeData": { "type": "string" },
    "CapeId": { "type": "string" },
    "CapeImageHeight": { "type": "integer" },
    "CapeImageWidth": { "type": "integer" },
    "CapeOnClassicSkin": { "type": "boolean" },
    "PersonaPieces": { "type": "array", "items": { "type": "object" } },
    "PersonaSkin": { "type": "boolean" },
    "PieceTintColors": { "type": "array", "items": { "type": "object" } },
    "PremiumSkin": { "type": "boolean" },
    "SkinAnimationData": { "type": "string" },
    "SkinColor": { "type": "string" },
    "SkinData": { "description": "The skin's RGBA pixels, base64", "type": "string" },
    "SkinGeometryData": { "description": "Its geometry JSON, base64", "type": "string" },
    "SkinGeometryDataEngineVersion": { "description": "The engine version of its geometry, base64; from 1.17.30", "type": "string" },
    "SkinId": { "description": "Its id, its persona id the fixed persona-123456789012345-0", "type": "string" },
    "SkinImageHeight": { "type": "integer" },
    "SkinImageWidth": { "type": "integer" },
    "SkinResourcePatch": { "description": "Its geometry names, base64", "type": "string" }
  }
}
