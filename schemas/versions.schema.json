{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/versions.schema.json",
  "title": "versions.json: every release kept, newest first",
  "type": "object",
  "required": ["formatVersion", "release"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": ["builds"],
      "additionalProperties": false,
      "properties": {
        "latest": { "$ref": "#/definitions/build" },
        "builds": { "type": "array", "items": { "$ref": "#/definitions/build" }, "uniqueItems": true }
      }
    }
  },
  "definitions": {
    "build": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" }
  }
}
