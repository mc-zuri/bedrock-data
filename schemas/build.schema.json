{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/build.schema.json",
  "title": "release/<build>/build.json: a release's zips, and what was extracted from which of them",
  "type": "object",
  "required": ["build", "version", "channel", "binary", "data"],
  "additionalProperties": false,
  "properties": {
    "build": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "channel": { "const": "release" },
    "binary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "linux": { "$ref": "#/definitions/download" },
        "windows": { "$ref": "#/definitions/download" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "language.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "blockPalette": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "block_palette.nbt" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "blockShapes": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "block_shapes.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        }
      }
    }
  },
  "definitions": {
    "platform": { "enum": ["linux", "windows"] },
    "download": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://www\\.minecraft\\.net/bedrockdedicatedserver/bin-(linux|win)/bedrock-server-\\d+\\.\\d+\\.\\d+\\.\\d+\\.zip$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
