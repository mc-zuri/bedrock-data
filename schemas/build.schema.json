{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/build.schema.json",
  "title": "<channel>/<build>/build.json: a build's zips, and what was extracted from which of them",
  "type": "object",
  "required": ["build", "version", "channel", "binary", "data"],
  "additionalProperties": false,
  "properties": {
    "build": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-preview\\.\\d+)?$" },
    "channel": { "enum": ["release", "preview"] },
    "binary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "linux": { "$ref": "#/definitions/download" },
        "windows": { "$ref": "#/definitions/download" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "language.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "blockPalette": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "block_palette.nbt" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "blockShapes": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "block_shapes.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "blocks": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "blocks.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "items": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "items.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "enchantments": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "enchantments.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "biomes": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "biomes.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "effects": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "effects.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "enums": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "enums.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "tints": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "tints.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "recipes": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "recipes.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "entities": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "entities.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "commands": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "commands.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "attributes": {
          "type": "object",
          "required": ["file", "from"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "attributes.json.gz" },
            "from": { "$ref": "#/definitions/platform" }
          }
        },
        "steve": {
          "description": "Recorded from a client of the release's version: no platform's",
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": { "const": "steve.json.gz" }
          }
        }
      }
    }
  },
  "if": { "properties": { "channel": { "const": "preview" } } },
  "then": { "properties": { "version": { "pattern": "-preview\\.\\d+$" } } },
  "else": { "properties": { "version": { "pattern": "^\\d+\\.\\d+\\.\\d+$" } } },
  "definitions": {
    "platform": { "enum": ["linux", "windows"] },
    "download": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://www\\.minecraft\\.net/bedrockdedicatedserver/bin-(linux|win)(-preview)?/bedrock-server-\\d+\\.\\d+\\.\\d+\\.\\d+\\.zip$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
