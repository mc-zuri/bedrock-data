{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mc-zuri/bedrock-data/schemas/tints.schema.json",
  "title": "release/<build>/tints.json.gz (decompressed): the colours the server draws its maps with",
  "type": "object",
  "required": ["biomes", "redstone", "constant"],
  "additionalProperties": false,
  "properties": {
    "biomes": {
      "description": "Each biome's grass, foliage and water, by name",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "grass", "foliage"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "grass": { "$ref": "#/definitions/color" },
          "foliage": { "$ref": "#/definitions/color" },
          "water": { "description": "Where the agent reads one", "$ref": "#/definitions/color" }
        }
      }
    },
    "redstone": { "description": "The redstone wire's colour in each of its states, in state order; none where the server keeps none", "type": "array", "items": { "$ref": "#/definitions/color" } },
    "constant": {
      "description": "The block types tinted with one colour wherever they are, in runtime id order",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "color"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "color": { "$ref": "#/definitions/color" }
        }
      }
    }
  },
  "definitions": {
    "color": { "description": "0xRRGGBB", "type": "integer", "minimum": 0, "maximum": 16777215 }
  }
}
